# Copy to .env to override. Vite only exposes variables prefixed with VITE_.

# Base URL of the Spring Boot API.
VITE_API_BASE_URL=http://localhost:8080

# Credentials used by the one-click Demo Mode button. These must match a user in
# app.security.users on the backend. Replace them for any shared deployment.
VITE_DEMO_USERNAME=analyst
VITE_DEMO_PASSWORD=cyclone-demo-analyst
